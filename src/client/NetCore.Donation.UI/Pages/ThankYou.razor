@page "/donate/thanks"
@inject DonationApiClient Api
@inject IJSRuntime JS

<PageTitle>Thank you — Hope &amp; Help</PageTitle>

<div class="card-panel">
    <h1>Thank you</h1>
    <p>Your simulated donation has been recorded. A journal line and digital receipt were created.</p>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    <dl class="row">
        <dt class="col-sm-3">Receipt</dt>
        <dd class="col-sm-9"><code>@receiptId</code></dd>
        <dt class="col-sm-3">Transaction</dt>
        <dd class="col-sm-9"><code>@transactionId</code></dd>
    </dl>

    <button class="btn btn-give" type="button" disabled="@busy" @onclick="DownloadReceiptAsync">
        @(busy ? "Preparing PDF…" : "Download receipt PDF")
    </button>
    <a class="btn btn-outline-secondary ms-2" href="gifts">View my gifts</a>
</div>

@code {
    [SupplyParameterFromQuery]
    public Guid ReceiptId { get; set; }

    [SupplyParameterFromQuery]
    public Guid TransactionId { get; set; }

    private Guid receiptId;
    private Guid transactionId;
    private bool busy;
    private string? error;

    protected override void OnParametersSet()
    {
        receiptId = ReceiptId;
        transactionId = TransactionId;
    }

    private async Task DownloadReceiptAsync()
    {
        if (receiptId == Guid.Empty)
        {
            error = "No receipt was returned for this gift.";
            return;
        }

        error = null;
        busy = true;
        try
        {
            var pdf = await Api.GetReceiptPdfAsync(receiptId);
            await JS.InvokeVoidAsync("downloadFile", $"receipt-{receiptId:N}.pdf", "application/pdf", pdf);
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
